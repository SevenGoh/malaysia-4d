{
  "crons": [
    {
      "path": "/api/cron/fetch?force=true",
      "schedule": "0 11 * * 0,3,6"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ]
}
