# Local dev: uses file SQLite (no Turso account needed)
TURSO_DATABASE_URL=file:data/results.db

# Production (Turso): create a free DB at https://turso.tech
# TURSO_DATABASE_URL=libsql://your-db-name-org.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token

# Optional: protect /api/cron/fetch (Vercel sets this in dashboard)
# CRON_SECRET=generate-a-random-string

# Google AdSense / AdMob (web ads — works in browser + Android TWA)
# 1. Create app at https://admob.google.com
# 2. Link AdSense: AdMob → Apps → Add → Web → enter malaysia-4d.vercel.app
# 3. Create ad units → copy client id (ca-pub-...) and slot ids
# NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX
# NEXT_PUBLIC_ADSENSE_SLOT_FOOTER=1234567890
# NEXT_PUBLIC_ADSENSE_SLOT_CONTENT=0987654321
# ADSENSE_PUBLISHER_ID=pub-XXXXXXXXXXXXXXXX
# NEXT_PUBLIC_ADS_ENABLED=true
