# Local dev: uses file SQLite (no Turso account needed)
TURSO_DATABASE_URL=file:data/results.db

# Production (Turso): create a free DB at https://turso.tech
# TURSO_DATABASE_URL=libsql://your-db-name-org.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token

# Optional: protect /api/cron/fetch (Vercel sets this in dashboard)
# CRON_SECRET=generate-a-random-string
